---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import {
  project,
  developer,
  agency,
  agent,
  site,
  independenceNotice,
} from "../config/site";

const title = `${project.name} | Pre-Launch Private-Lift Residences, Section 13 Petaling Jaya`;
const description = `${project.name} — a low-density pre-launch development by ${developer.name}, facing Plaza 33 in Section 13, Petaling Jaya. 3 to 4-bedroom layouts from 1,165 to 1,880 sqft, each with its own private lift lobby. Independent marketing site by ${agent.name} (${agent.ren}), ${agency.name}.`;
const ogImage = `${site.url}/assets/og-image.jpg`;

const apartmentComplex = {
  "@context": "https://schema.org",
  "@type": "ApartmentComplex",
  name: project.name,
  description:
    "A low-density collection of private-lift residences in Section 13, Petaling Jaya. Layouts range from 1,165 to 1,880 sqft, each with its own private lift lobby, and up to three carparks.",
  url: `${site.url}/`,
  image: ogImage,
  numberOfBedrooms: "3-4",
  petsAllowed: true,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jalan Kemajuan / Jalan 13/1, Section 13",
    addressLocality: "Petaling Jaya",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  developer: {
    "@type": "Organization",
    name: developer.name,
  },
  containsPlace: [
    {
      "@type": "Apartment",
      name: "Type A",
      floorSize: { "@type": "QuantitativeValue", value: 1880, unitCode: "FTK" },
      numberOfBedrooms: 4,
      numberOfBathroomsTotal: 4,
    },
    {
      "@type": "Apartment",
      name: "Type B1",
      floorSize: { "@type": "QuantitativeValue", value: 1574, unitCode: "FTK" },
      numberOfBedrooms: 3,
      numberOfBathroomsTotal: 4,
    },
    {
      "@type": "Apartment",
      name: "Type C1",
      floorSize: { "@type": "QuantitativeValue", value: 1165, unitCode: "FTK" },
      numberOfBedrooms: 3,
      numberOfBathroomsTotal: 2,
    },
  ],
};

const realEstateAgent = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: `${agent.name} — ${agency.name}`,
  description: independenceNotice,
  image: ogImage,
  url: `${site.url}/`,
  telephone: agent.phoneDisplay,
  email: agent.email,
  identifier: agent.ren,
  parentOrganization: {
    "@type": "Organization",
    name: agency.name,
    identifier: `BOVAEP ${agency.licence}`,
  },
  areaServed: "Petaling Jaya, Selangor, Malaysia",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1-1, PJ 21 Commercial Centre, Jalan SS3/39",
    postalCode: "47300",
    addressLocality: "Petaling Jaya",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  knowsAbout: `${project.name}, private-lift residences in Petaling Jaya`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/pjpropertylogo.svg" />

    <!-- ============ SEO ============ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Accent PJ, Accent Petaling Jaya, Avaland Accent, PJ new launch, private lift condo PJ, new launch Petaling Jaya, Section 13 PJ condo, low density condo Petaling Jaya"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={`${agent.name}, ${agent.ren}`} />
    <link rel="canonical" href={`${site.url}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site.url}/`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:wght@400;500;600;700&family=Hanken+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- ============ Structured data ============ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(apartmentComplex)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(realEstateAgent)}
    />

    <!-- ============ Speed Insights ============ -->
    <SpeedInsights />
  </head>
  <body id="top">
    <slot />
  </body>
</html>
