---
import { project, developer, waLink } from "../config/site";

const stats = [
  { title: "Section 13, PJ", note: "A central, mature Petaling Jaya address." },
  { title: "Facing Plaza 33", note: "Fronting Jalan Kemajuan & Jalan 13/1." },
  {
    title: "Pre-launch preview",
    note: "Registration is open ahead of the official launch.",
  },
  {
    title: "Developer",
    note: developer.name,
  },
];

const groups = [
  {
    title: "Shopping",
    icon: "/assets/icons/shopping-bag.svg",
    items: [
      ["Jaya Shopping Centre", "850 m"],
      ["Jaya 33", "1.3 km"],
      ["Jaya One", "2.1 km"],
      ["Mid Valley Megamall", "5.3 km"],
    ],
  },
  {
    title: "Healthcare",
    icon: "/assets/icons/cross.svg",
    items: [
      ["Hospital Picaso", "1.3 km"],
      ["Columbia Asia Hospital PJ", "1.9 km"],
      ["University Malaya Medical Centre", "2.2 km"],
      ["Assunta Hospital", "3.4 km"],
    ],
  },
  {
    title: "Education",
    icon: "/assets/icons/graduation-cap.svg",
    items: [
      ["SK Sri Petaling", "600 m"],
      ["Bukit Bintang Boys' Secondary", "700 m"],
      ["University Malaya", "3.3 km"],
      ["Nobel International School", "6.5 km"],
    ],
  },
  {
    title: "Connectivity",
    icon: "/assets/icons/connectivity.svg",
    items: [
      ["Phileo Damansara MRT", "3.0 km"],
      ["Asia Jaya LRT", "3.5 km"],
      ["Federal Highway", "Direct"],
      ["LDP / Sprint Expressway", "Nearby"],
    ],
  },
];

const brochureHref = waLink(
  `Hi Chloe, could you send me the ${project.name} brochure?`,
);
---

<section
  id="location"
  class="bg-forest text-forest-text py-20 px-gutter"
>
  <div class="max-w-wrap mx-auto flex flex-col gap-[60px]">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2
        class="font-inter font-semibold text-[clamp(26px,3.2vw,42px)] leading-[1.15] tracking-[-0.008em] max-w-[400px]"
      >
        In the heart of Petaling Jaya
      </h2>
      <p
        class="text-[15.5px] text-[rgba(242,237,226,0.78)] max-w-[500px] leading-[1.7] font-light"
      >
        The development sits along Jalan Kemajuan and Jalan 13/1 in Section 13,
        facing Plaza 33 — where the calm of an established address meets the
        convenience of the city. Quietly set apart, yet effortlessly connected
        to everything that matters.
      </p>
    </div>

    <div class="flex flex-col md:flex-row gap-10 items-center">
      <div class="relative rounded-[8px] overflow-hidden flex-1 w-full">
        <img
          class="w-full h-auto"
          src="/assets/location-map-petaling-jaya.webp"
          alt="Map showing the development's location in the heart of Petaling Jaya, facing Plaza 33"
          loading="lazy"
        />
      </div>

      <div class="flex flex-col gap-8 justify-center md:w-[480px] flex-none">
        {
          stats.map((s, i) => (
            <div
              class:list={[
                "pb-4",
                i < stats.length - 1 &&
                  "border-b border-[rgba(242,237,226,0.12)]",
              ]}
            >
              <h3 class="font-serif text-[28px] font-semibold mb-2">
                {s.title}
              </h3>
              <p class="text-[13.5px] leading-[1.6] text-[rgba(242,237,226,0.66)] font-light">
                {s.note}
              </p>
            </div>
          ))
        }
        <a
          href={brochureHref}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 self-start px-9 py-[18px] rounded-[40px] bg-accent-hover text-hero text-[13px] font-semibold tracking-[0.14em] uppercase transition-colors duration-[250ms] hover:bg-accent"
        >
          <img
            src="/assets/icons/whatsapp-mark.svg"
            alt=""
            aria-hidden="true"
            width="18"
            height="18"
            class="w-[18px] h-[18px] flex-none"
          />
          WhatsApp for Brochure
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <div
        class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-10"
      >
        {
          groups.map((g) => (
            <div class="border-r border-[rgba(242,237,226,0.12)] pr-8 pb-4 last:border-none last:pr-0 flex flex-col gap-[18px]">
              <div class="flex items-center gap-2">
                <img
                  src={g.icon}
                  alt=""
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="w-5 h-5 flex-none"
                />
                <h4
                  class="text-[11.5px] tracking-[0.16em] uppercase text-accent-hover font-bold"
                >
                  {g.title}
                </h4>
              </div>
              <ul class="list-none flex flex-col gap-[13px]">
                {g.items.map(([name, dist]) => (
                  <li class="flex justify-between gap-3 text-sm text-[rgba(242,237,226,0.82)]">
                    <span>{name}</span>
                    <span class="text-[rgba(242,237,226,0.45)] whitespace-nowrap">
                      {dist}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="text-[12.5px] text-[rgba(242,237,226,0.4)] leading-[1.6]">
        Distances are approximate and for reference only.
      </p>
    </div>
  </div>
</section>
