---
// Sits inside the Private Lift section in the redesign, so it carries no
// section padding or rules of its own.
const facts = [
  { num: "3", label: "Layout types" },
  {
    num: "1,165–1,880",
    label: "Built-up (sqft)",
    size: "text-[clamp(22px,2.4vw,32px)]",
  },
  { num: "3–4", label: "Bedrooms" },
  { num: "Up to 3", label: "Carparks" },
];
---

<div
  class="w-full grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-12"
>
  {
    facts.map((fact) => (
      <div>
        <div
          class:list={[
            "font-serif font-medium leading-none whitespace-nowrap",
            fact.size ?? "text-[clamp(32px,3.6vw,46px)]",
          ]}
        >
          {fact.num}
        </div>
        <div class="text-[13.5px] tracking-[0.06em] text-muted-2 mt-3">
          {fact.label}
        </div>
      </div>
    ))
  }
</div>
