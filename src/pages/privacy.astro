---
import LegalLayout from "../layouts/LegalLayout.astro";
import {
  project,
  developer,
  agency,
  agent,
  independenceNotice,
} from "../config/site";

const lastUpdated = "18 August 2026";
---

<LegalLayout
  title={`Privacy Policy | ${project.name}`}
  description={`How ${agency.name} and ${agent.name} (${agent.ren}) collect, use and protect your personal data under Malaysia's Personal Data Protection Act 2010.`}
  heading="Privacy Policy"
  lastUpdated={lastUpdated}
  path="/privacy/"
>
  <div class="bg-paper rounded-[8px] p-6 text-[14.5px] leading-[1.7] text-ink">
    <p class="font-semibold mb-2">Who we are</p>
    <p>{independenceNotice}</p>
  </div>

  <p>
    This Privacy Policy explains how {agent.name} ({agent.ren}) and {
      agency.name
    } (Registered Estate Agency, BOVAEP {agency.licence}) collect, use, disclose
    and protect your personal data in connection with enquiries about {
      project.name
    }. We handle personal data in accordance with Malaysia's Personal Data
    Protection Act 2010 (PDPA).
  </p>

  <section>
    <h2>1. Information we collect</h2>
    <p class="mb-3">
      This website has no enquiry form and does not collect personal data from
      you on the page itself. We only receive what you choose to send us when
      you contact us by WhatsApp, telephone or email — typically:
    </p>
    <ul>
      <li>Your name;</li>
      <li>Your mobile number (including your WhatsApp profile details);</li>
      <li>Your email address, if you email us;</li>
      <li>The layout or information you are interested in, and your message.</li>
    </ul>
  </section>

  <section>
    <h2>2. How we use your information</h2>
    <p class="mb-3">We use your personal data to:</p>
    <ul>
      <li>
        Respond to your enquiry and send you floor plans, indicative pricing and
        launch information you have asked for;
      </li>
      <li>
        Contact you by phone, WhatsApp, email or SMS about {project.name};
      </li>
      <li>Arrange viewings and follow up on your expression of interest;</li>
      <li>Comply with our legal and regulatory obligations.</li>
    </ul>
  </section>

  <section>
    <h2>3. Analytics and advertising cookies</h2>
    <p class="mb-3">
      This website uses Vercel Web Analytics and Vercel Speed Insights, which
      collect aggregated, anonymous usage and performance data and do not use
      cookies to identify you individually.
    </p>
    <p class="mb-3">
      We promote this website through Google Ads. Where advertising or
      remarketing tags are active:
    </p>
    <ul>
      <li>
        Third-party vendors, including Google, may use cookies to serve ads
        based on your previous visits to this website;
      </li>
      <li>
        Google's use of advertising cookies enables Google and its partners to
        serve ads to you based on your visit to this site and/or other sites on
        the internet;
      </li>
      <li>
        You may opt out of personalised advertising through <a
          href="https://www.google.com/settings/ads"
          target="_blank"
          rel="nofollow noopener noreferrer">Google Ads Settings</a
        >, or opt out of third-party vendors' use of cookies via the <a
          href="https://optout.networkadvertising.org/"
          target="_blank"
          rel="nofollow noopener noreferrer"
          >Network Advertising Initiative opt-out page</a
        >.
      </li>
    </ul>
  </section>

  <section>
    <h2>4. Disclosure of your information</h2>
    <p>
      We may share your personal data with the developer, {developer.name}, and
      its authorised sales representatives, for the sole purpose of processing
      your enquiry. We do not sell, rent or trade your personal data. We may
      disclose data where required by law or by a regulatory authority.
    </p>
  </section>

  <section>
    <h2>5. Data retention</h2>
    <p>
      We retain your personal data only for as long as necessary to fulfil the
      purposes set out in this policy, or as required to meet legal, tax or
      regulatory requirements, after which it is securely deleted.
    </p>
  </section>

  <section>
    <h2>6. Your rights</h2>
    <p>
      Under the PDPA you have the right to access and correct your personal
      data, to limit its processing, and to withdraw your consent at any time.
      To exercise any of these rights, contact us using the details below. Once
      consent is withdrawn we may be unable to continue sending you information
      about the development.
    </p>
  </section>

  <section>
    <h2>7. Contact us</h2>
    <p class="mb-4">
      For any question about this Privacy Policy or how your personal data is
      handled, please contact:
    </p>
    <div class="bg-paper rounded-[8px] p-6 text-[14.5px] leading-[1.7] text-ink">
      <p class="font-semibold">{agent.name} · {agent.ren}</p>
      <p class="text-muted">
        {agency.name} — Registered Estate Agency, BOVAEP {agency.licence}
      </p>
      <p class="mt-2">{agency.address}</p>
      <p class="mt-2">
        <a href={`tel:${agent.phoneHref}`}>{agent.phoneDisplay}</a>
        &nbsp;·&nbsp;
        <a href={`mailto:${agent.email}`}>{agent.email}</a>
      </p>
    </div>
  </section>
</LegalLayout>
